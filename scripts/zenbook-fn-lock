#!/bin/bash
# Bloqueo Fn del teclado del Zenbook Duo
#
# Uso: zenbook-fn-lock [on|off|toggle|status|init] [-q]   (-q: sin aviso en pantalla)
#   on      Bloqueo Fn activado: las teclas F hacen F1..F12 (Fn+F = multimedia)
#   off     Bloqueo Fn desactivado: las teclas F hacen su acción multimedia (Fn+F = F1..F12)
#   toggle  Alterna el estado actual
#   status  Lee el estado del teclado y lo imprime (on|off). Por USB desacopla la interfaz 4 un
#           instante: no usarlo en automático (hace que zenbook-hotkeys pierda su nodo hidraw)
#   init    Envía el saludo "ASUS Tech.Inc." que hid-asus manda a sus teclados
#
# El teclado no cambia solo con Fn+Esc: emite el reporte 5a 4e y es el host quien
# tiene que reenviar 5a d0 4e <0|1> (como hace hid-asus). Eso lo hace
# zenbook-hotkeys llamando a `zenbook-fn-lock toggle`.
#
# Por USB el estado se lee del teclado (GET_REPORT). Por Bluetooth se intenta
# igual y, si no responde, se usa el último estado enviado.
# El estado se publica en FNLOCK_STATE_FILE (0 = off, 1 = on) para la extensión.
#
# Envío igual que zenbook-keyboard-backlight: por USB ctrl_transfer a la interfaz 4, por
# Bluetooth hidraw. Se auto-eleva con sudo -n (ver sudoers en install.sh).
# on, off y toggle muestran el indicador inferior de GNOME (osd-zenbook), como zenbook-microphone.

PYTHON3=$(which python3)
KB_NAME="Zenbook Duo"
KB_USB_ID="0b05:1b2c"
FNLOCK_STATE_FILE="/tmp/zenbook-fnlock-state"
[[ -r /etc/zenbook-duo.conf ]] && source /etc/zenbook-duo.conf

# Modo interno: la parte privilegiada se ejecuta con `sudo -n zenbook-fn-lock _root ...`
# y la notificación la envía el proceso del usuario (root no llega a la sesión gráfica).
ROOT_MODE=""
[[ "$1" == "_root" ]] && { ROOT_MODE=1; shift; }

case "${1:-}" in
    on|off|toggle|status|init) ;;
    *)
        echo "Uso: zenbook-fn-lock [on|off|toggle|status|init]"
        exit 1
        ;;
esac

if [[ -z "$ROOT_MODE" && $EUID -ne 0 ]]; then
    out=$(sudo -n "$0" _root "$@")
    rc=$?
    [[ -n "$out" ]] && echo "$out"
    if [[ $rc -eq 0 && "$2" != "-q" && "$1" =~ ^(on|off|toggle)$ ]]; then
        if [[ "$out" == *": on"* ]]; then
            icon="changes-prevent-symbolic"; text="Bloqueo Fn"
        else
            icon="changes-allow-symbolic"; text="Bloqueo Fn"
        fi
        # Indicador en pantalla de GNOME (extensión osd-zenbook por D-Bus); si no está cargada, notificación
        gdbus call --session --dest org.gnome.Shell --object-path /org/zenbook/Osd \
            --method org.zenbook.Osd.ShowText "$icon" "$text" > /dev/null 2>&1 || \
            notify-send -a "Bloqueo Fn" -i "$icon" -h string:x-canonical-private-synchronous:zenbook-fn-lock \
                -t 1500 "$text" 2>/dev/null
    fi
    exit $rc
fi

function _find_hidraw_devices() {
    local uevent driver hid_id bus phys dev
    for uevent in /sys/class/hidraw/*/device/uevent; do
        grep -qi "$KB_NAME" "$uevent" 2>/dev/null || continue
        driver=$(grep 'DRIVER=' "$uevent" | sed 's/DRIVER=//')
        [[ "$driver" == "hid-multitouch" || "$driver" == "hid-sensor-hub" ]] && continue
        hid_id=$(grep 'HID_ID=' "$uevent" | sed 's/HID_ID=//')
        bus="${hid_id%%:*}"
        dev="/dev/$(basename "$(dirname "$(dirname "$uevent")")")"
        phys=$(grep 'HID_PHYS=' "$uevent" | sed 's/HID_PHYS=//')
        [[ "$bus" == "0003" && "$phys" != */input4 ]] && continue
        echo "$dev"
    done
}

KB_USB_ID="$KB_USB_ID" FNLOCK_STATE_FILE="$FNLOCK_STATE_FILE" MODE="$1" \
    "$PYTHON3" - $(_find_hidraw_devices) << 'PYEOF'
import sys, os, fcntl

mode = os.environ['MODE']
state_file = os.environ['FNLOCK_STATE_FILE']
HIDIOCSFEATURE = 0xC0104806
HIDIOCGFEATURE = 0xC0104807
INIT = bytes.fromhex("5a 41 53 55 53 20 54 65 63 68 2e 49 6e 63 2e 00")


def report(*payload):
    data = bytearray(payload)
    return data + bytes(16 - len(data))


def usb_transfer(send, data=None):
    """send=True: SET_REPORT; False: GET_REPORT. None si no hay teclado USB."""
    try:
        import usb.core, usb.util
        vid, pid = (int(x, 16) for x in os.environ['KB_USB_ID'].split(':'))
        dev = usb.core.find(idVendor=vid, idProduct=pid)
    except Exception:
        return None
    if dev is None:
        return None
    WINDEX = 4
    was_active = dev.is_kernel_driver_active(WINDEX)
    if was_active:
        dev.detach_kernel_driver(WINDEX)
    try:
        if send:
            dev.ctrl_transfer(0x21, 0x09, 0x035A, WINDEX, list(data), timeout=1000)
            return b''
        return bytes(dev.ctrl_transfer(0xA1, 0x01, 0x035A, WINDEX, 16, timeout=1000))
    except usb.core.USBError as e:
        print(f"ctrl_transfer USB falló: {e}", file=sys.stderr)
        return None
    finally:
        usb.util.release_interface(dev, WINDEX)
        if was_active:
            try:
                dev.attach_kernel_driver(WINDEX)
            except Exception:
                pass


def hidraw_transfer(send, data=None):
    for path in sys.argv[1:]:
        try:
            with open(path, 'r+b') as f:
                if send:
                    fcntl.ioctl(f, HIDIOCSFEATURE, data)
                    return b''
                buf = bytearray(16)
                buf[0] = 0x5A
                return bytes(fcntl.ioctl(f, HIDIOCGFEATURE, buf))
        except OSError:
            continue
    return None


def transfer(send, data=None):
    if send:
        # hidraw primero: no desacopla el driver de la interfaz 4 (pyusb sí, y eso recrea el
        # nodo hidraw y deja ciego a quien lo escucha, p. ej. zenbook-hotkeys)
        result = hidraw_transfer(True, data)
        return result if result is not None else usb_transfer(True, data)
    # La lectura solo responde por USB (GET_REPORT), y exige desacoplar la interfaz un instante
    result = usb_transfer(False)
    return result if result is not None else hidraw_transfer(False)


def write_state(on):
    with open(state_file, 'w') as f:
        f.write('1\n' if on else '0\n')
    os.chmod(state_file, 0o644)


def read_state():
    """True/False si el teclado lo informa; None si no responde."""
    reply = transfer(False)
    if reply and len(reply) >= 4 and reply[1:3] == b'\xd0\x4e':
        on = bool(reply[3])
        write_state(on)
        return on
    return None


def last_state():
    try:
        with open(state_file) as f:
            return f.read().strip() == '1'
    except OSError:
        return False


def set_state(on):
    if transfer(True, report(0x5A, 0xD0, 0x4E, int(on))) is None:
        print("Error: no se pudo enviar el reporte", file=sys.stderr)
        sys.exit(1)
    write_state(on)
    print(f"Bloqueo Fn: {'on' if on else 'off'}")


if mode == 'init':
    if transfer(True, bytearray(INIT)) is None:
        print("Error: no se pudo enviar el reporte", file=sys.stderr)
        sys.exit(1)
    print("Saludo enviado")
elif mode in ('on', 'off'):
    set_state(mode == 'on')
elif mode == 'toggle':
    # Sin leer del teclado (la lectura desacopla la interfaz 4 y reinicia a los oyentes de hidraw):
    # el firmware no cambia solo, así que el último estado enviado es el real.
    set_state(not last_state())
elif mode == 'status':
    current = read_state()
    if current is None:
        print(f"Bloqueo Fn: {'on' if last_state() else 'off'} (sin verificar: el teclado no respondió)")
        sys.exit(2)
    print(f"Bloqueo Fn: {'on' if current else 'off'}")
PYEOF
