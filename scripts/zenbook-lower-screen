#!/bin/bash
# Pantalla inferior (eDP-2) del Zenbook Duo
#
# Uso: zenbook-lower-screen [on|off|toggle|status]
#
# Solo cambia la pantalla. Quién decide cuándo (al conectar o desconectar el teclado) es el
# servicio zenbook-keyboard-monitor; la tecla dedicada usa toggle (zenbook-hotkeys).

MONITOR_UPPER="eDP-1"
MONITOR_LOWER="eDP-2"
[[ -r /etc/zenbook-duo.conf ]] && source /etc/zenbook-duo.conf

# Indicador en pantalla de GNOME (lo muestra la extensión on-screen-display por D-Bus);
# si la extensión no está cargada, notificación normal.
# Texto "Pantalla inferior: encendida|apagada" con el icono de pantalla; apagada sale atenuado,
# como los iconos de mute. Uso: _osd on|off
# Cadena de respaldo: ShowState; ShowText (versión anterior de la extensión, sin atenuar el icono,
# hasta reiniciar sesión); notify-send (extensión no cargada; sale arriba, no abajo).
function _osd() {
    local state="encendida" on=true text
    [[ "$1" == "off" ]] && { state="apagada"; on=false; }
    text="Pantalla inferior: $state"
    local osd=(gdbus call --session --dest org.gnome.Shell --object-path /org/zenbook/Osd --method)
    "${osd[@]}" org.zenbook.Osd.ShowState video-display-symbolic "$text" "$on" > /dev/null 2>&1 && return
    "${osd[@]}" org.zenbook.Osd.ShowText video-display-symbolic "$text" > /dev/null 2>&1 && return
    notify-send -a "Monitor" -i video-display-symbolic "$text" 2>/dev/null
}

function _scale() { gdctl show | grep "Scale:" | head -1 | grep -oP '[\d.]+'; }

# Estado real del panel (DRM): "enabled"/"disabled". Es más fiable que contar monitores lógicos,
# que con un monitor externo conectado cuenta de más. Si no se puede leer, no se asume nada.
function _lower_state() { cat /sys/class/drm/card*-"$MONITOR_LOWER"/enabled 2>/dev/null | head -1; }

# on/off no hacen nada si la pantalla ya está así: reaplicar la disposición reordena las ventanas,
# repite el aviso y reasigna touchscreens sin necesidad (p. ej. al despertar de la suspensión).
# Rotación actual de la pantalla superior (normal|90|180|270). on/off la conservan: antes reaplicaban
# siempre "normal", y como el acelerómetro solo avisa cuando el equipo se mueve, la autorrotación no
# volvía a girar las pantallas y quedaban en horizontal con el equipo en vertical.
function _upper_transform() {
    gdctl show 2>/dev/null | awk -v c="$MONITOR_UPPER" '
        /Logical monitor #/ { t = "normal" }
        /Transform:/ { t = $NF }
        $0 ~ ("──" c " \\(") && $0 !~ /Monitor / { print t; found = 1; exit }
        END { if (!found) print "normal" }'
}

# on/off no hacen nada si la pantalla ya está así: reaplicar la disposición reordena las ventanas,
# repite el aviso y reasigna touchscreens sin necesidad (p. ej. al despertar de la suspensión).
function _on() {
    if [[ "$(_lower_state)" == "enabled" ]]; then echo "Pantalla inferior ya estaba encendida"; return; fi
    local scale transform side
    scale=$(_scale); transform=$(_upper_transform)
    # Misma disposición que zenbook-screen-rotation: la inferior queda "debajo" según la rotación
    case "$transform" in
        90)  side=(--left-of  "$MONITOR_UPPER") ;;
        270) side=(--right-of "$MONITOR_UPPER") ;;
        180) side=(--above    "$MONITOR_UPPER") ;;
        *)   side=(--below    "$MONITOR_UPPER"); transform=normal ;;
    esac
    gdctl set \
        --logical-monitor --primary --scale "$scale" --monitor "$MONITOR_UPPER" --transform "$transform" \
        --logical-monitor --scale "$scale" --monitor "$MONITOR_LOWER" "${side[@]}" --transform "$transform"
    _osd on
    echo "Pantalla inferior encendida"
    # Reaplica el mapeo de touchscreens tras cambiar la topología
    command -v zenbook-touchscreen > /dev/null && (sleep 1; zenbook-touchscreen setup) &
}

function _off() {
    if [[ "$(_lower_state)" == "disabled" ]]; then echo "Pantalla inferior ya estaba apagada"; return; fi
    local scale transform
    scale=$(_scale); transform=$(_upper_transform)
    gdctl set --logical-monitor --primary --scale "$scale" --monitor "$MONITOR_UPPER" --transform "$transform"
    _osd off
    echo "Pantalla inferior apagada"
}

case "${1:-toggle}" in
    on)     _on ;;
    off)    _off ;;
    toggle) [[ "$(_lower_state)" == "enabled" ]] && _off || _on ;;
    status)
        scale=$(_scale)
        [[ "$(_lower_state)" == "enabled" ]] && state="ON" || state="OFF"
        echo "Superior: $MONITOR_UPPER | Inferior: $MONITOR_LOWER → $state | Escala: $scale"
        ;;
    *)
        echo "Uso: zenbook-lower-screen [on|off|toggle|status]"
        exit 1
        ;;
esac
